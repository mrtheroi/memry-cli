{
    "name": "mrtheroi/memry-cli",
    "description": "CLI for memry: log in from the terminal and wire the memry memory MCP into Claude Code.",
    "keywords": [
        "memry",
        "mcp",
        "claude-code",
        "cli"
    ],
    "homepage": "https://github.com/mrtheroi/memry-cli",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "mrtheroi"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.15",
        "illuminate/http": "^13.0",
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^4.7.8 || ^5.0.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "memry"
    ]
}
